{
  "name": "@northeastern-web/kernl-ui",
  "version": "4.0.0",
  "source": "src/js/index.js",
  "main": "dist/js/index.js",
  "unpkg": "dist/js/index.umd.js",
  "description": "Northeastern front-end framework built on Tailwind CSS",
  "style": "dist/css/index.css",
  "repository": "https://github.com/ITS-Digital-Technology/kernl-ui.git",
  "homepage": "https://northeastern.netlify.com",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "microbundle --name=@northeastern-web/kernl-ui --external=none && microbundle -i src/js/browser-update.js -o dist/js/browser-update.js --name=@northeastern-web/browser-update --no-pkg-main -f cjs",
    "build:css": "node scripts/generate-cdn-candidates.js && tailwindcss -c ./cdn.config.js -i ./src/css/index.css -o ./dist/css/index.css --minify",
    "build:css:source": "npm run build:css && node scripts/generate-cdn-source.js"
  },
  "dependencies": {
    "feather-icons": "^4.29.2",
    "lodash.clonedeep": "^4.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.21.0",
    "@babel/core": "^7.21.4",
    "@tailwindcss/cli": "^4.3.3",
    "microbundle": "^0.15.1"
  },
  "overrides": {
    "microbundle": {
      "rollup-plugin-terser": {
        "serialize-javascript": "^7.1.2"
      }
    }
  }
}
